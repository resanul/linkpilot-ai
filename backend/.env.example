APP_ENV=development
DATABASE_URL=sqlite:///./dev.db
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://YOUR_API_HOST/linkedin/callback
LINKEDIN_VERSION=202605
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your-server-side-gemini-api-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=generate-a-fernet-key
# Use a long random secret (32+ chars); keep outside source control.
LICENSE_SIGNING_SECRET=replace-with-long-random-secret
# Comma-separated Google account emails for Super Admin.
ADMIN_EMAILS=admin@example.com
